# .env.example — copy to .env and fill in real values
# NEVER commit .env itself

# Gemini API (for countermeasure generation)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API (alternative for countermeasure generation)
OPENAI_API_KEY=your-openai-api-key-here

# Application settings
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./trustfeed.db
CORS_ORIGINS=http://localhost:5173

# Image source search (backend/provenance). All optional.
# Without a key, that provider reports "unavailable". Images are only sent when a request sets search_web=true.
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here
TINEYE_API_KEY=your-tineye-api-key-here
SERPAPI_API_KEY=your-serpapi-api-key-here
# Path to recorded results. When set, searches are replayed from this file and never use the network.
# PROVENANCE_REPLAY_PATH=data/demo/provenance_demo.json
